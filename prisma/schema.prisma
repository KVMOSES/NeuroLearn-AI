generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  name             String
  passwordHash     String
  role             UserRole            @default(STUDENT)
  avatarUrl        String?
  bio              String?
  emailVerified    Boolean             @default(false)
  verifyToken      String?
  verifyTokenExp   DateTime?
  resetToken       String?
  resetTokenExp    DateTime?
  failedLogins     Int                 @default(0)
  lockedUntil      DateTime?
  trustedDevices   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  totalXP          Int                 @default(0)
  level            Int                 @default(1)
  currentStreak    Int                 @default(0)
  longestStreak    Int                 @default(0)
  lastActivityDate DateTime?
  announcements    Announcement[]      @relation("AnnouncementAuthor")
  classroomsOwned  Classroom[]          @relation("ClassroomOwner")
  classroomMembers ClassroomMember[]
  conversations    Conversation[]
  coursesAuthored  Course[]            @relation("CourseAuthor")
  calendarEvents   CalendarEvent[]
  diagnostics      DiagnosticSession[]
  documents        Document[]
  enrollments      Enrollment[]
  flashcards       Flashcard[]         @relation("FlashcardAuthor")
  flashcardReviews FlashcardReview[]
  folders          Folder[]
  knowledgeStates  KnowledgeState[]
  learnerProfile   LearnerProfile?
  learningPlans    LearningPlan[]
  learningSessions LearningSession[]
  progress         LessonProgress[]
  memoryStates     MemoryState[]
  quizAttempts     QuizAttempt[]
  sessions         Session[]
  streaks          StreakLog[]
  submissions      Submission[]
  topicsAuthored   Topic[]             @relation("TopicAuthor")
  achievements     UserAchievement[]
  xpEvents         XPEvent[]

  @@index([email])
  @@index([role])
}

model Session {
  id                String   @id @default(cuid())
  userId            String
  refreshToken      String   @unique
  deviceFingerprint String?
  userAgent         String?
  ipAddress         String?
  expiresAt         DateTime
  revoked           Boolean  @default(false)
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean   @default(false)
  timezone    String?
  color       String    @default("violet")
  location    String?
  /// JSON: { freq, interval, byDay?, count?, until? }
  recurrence  String?
  /// JSON array: [{ minutesBefore, method }]
  reminders   String?
  /// manual | assignment | quiz | exam | plan | focus | milestone | deadline
  source      String    @default("manual")
  refId       String?
  externalUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
}

model Course {
  id             String            @id @default(cuid())
  slug           String            @unique
  title          String
  description    String
  category       String
  difficulty     String            @default("beginner")
  color          String            @default("violet")
  iconUrl        String?
  estimatedHours Int               @default(0)
  tags           String?
  published      Boolean           @default(true)
  authorId       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  classrooms     ClassroomCourse[]
  author         User?             @relation("CourseAuthor", fields: [authorId], references: [id])
  enrollments    Enrollment[]
  modules        Module[]

  @@index([category])
  @@index([slug])
  @@index([authorId])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Lesson {
  id          String           @id @default(cuid())
  moduleId    String
  title       String
  summary     String
  content     String
  durationMin Int              @default(10)
  order       Int              @default(0)
  skillId     String?
  createdAt   DateTime         @default(now())
  flashcards  Flashcard[]
  skill       Skill?           @relation(fields: [skillId], references: [id])
  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  quizzes     Quiz[]

  @@index([moduleId])
  @@index([skillId])
}

model Skill {
  id               String              @id @default(cuid())
  name             String              @unique
  description      String?
  category         String?
  sourceDocumentId String?
  createdAt        DateTime            @default(now())
  states           KnowledgeState[]
  lessons          Lesson[]
  questions        Question[]
  quizzes          Quiz[]
  document         Document?           @relation("DocumentSkills", fields: [sourceDocumentId], references: [id])
  dependents       SkillPrerequisite[] @relation("SkillPrerequisite")
  prerequisites    SkillPrerequisite[] @relation("SkillDependent")

  @@index([category])
  @@index([sourceDocumentId])
}

model SkillPrerequisite {
  skillId        String
  prerequisiteId String
  prerequisite   Skill  @relation("SkillPrerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  skill          Skill  @relation("SkillDependent", fields: [skillId], references: [id], onDelete: Cascade)

  @@id([skillId, prerequisiteId])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  progress    Float     @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  status      String    @default("not_started")
  timeSpent   Int       @default(0)
  lastOpened  DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model KnowledgeState {
  id           String   @id @default(cuid())
  userId       String
  skillId      String
  pKnown       Float    @default(0.5)
  pTransit     Float    @default(0.1)
  pSlip        Float    @default(0.1)
  pGuess       Float    @default(0.25)
  observations Int      @default(0)
  lastUpdated  DateTime @default(now())
  skill        Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
}

model Flashcard {
  id         String            @id @default(cuid())
  lessonId   String?
  authorId   String?
  documentId String?
  front      String
  back       String
  hint       String?
  tags       String?
  createdAt  DateTime          @default(now())
  document   Document?         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author     User?             @relation("FlashcardAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  lesson     Lesson?           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  reviews    FlashcardReview[]

  @@index([lessonId])
  @@index([documentId])
  @@index([authorId])
}

model FlashcardReview {
  id          String    @id @default(cuid())
  userId      String
  flashcardId String
  quality     Int
  repetitions Int       @default(0)
  interval    Int       @default(0)
  easeFactor  Float     @default(2.5)
  nextReview  DateTime  @default(now())
  reviewedAt  DateTime  @default(now())
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
  @@index([userId, nextReview])
}

model Quiz {
  id          String        @id @default(cuid())
  lessonId    String?
  skillId     String?
  documentId  String?
  authorId    String?
  title       String
  description String?
  difficulty  String        @default("adaptive")
  createdAt   DateTime      @default(now())
  questions   Question[]
  document    Document?     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  skill       Skill?        @relation(fields: [skillId], references: [id])
  lesson      Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts    QuizAttempt[]

  @@index([lessonId])
  @@index([skillId])
  @@index([documentId])
}

model Question {
  id               String   @id @default(cuid())
  quizId           String
  prompt           String
  type             String   @default("mcq")
  options          String?
  correctIndex     Int?     @default(0)
  correctAnswer    String?
  numericAnswer    Float?
  numericTolerance Float?   @default(0.01)
  explanation      String?
  difficulty       Float    @default(0.5)
  skillId          String?
  topicId          String?
  createdAt        DateTime @default(now())
  answers          Answer[]
  topic            Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  skill            Skill?   @relation(fields: [skillId], references: [id])
  quiz             Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([skillId])
  @@index([topicId])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  userId      String
  quizId      String
  score       Float     @default(0)
  total       Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  answers     Answer[]
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
}

model Answer {
  id            String      @id @default(cuid())
  attemptId     String
  questionId    String
  selectedIndex Int?
  textAnswer    String?
  numericAnswer Float?
  correct       Boolean
  score         Float       @default(0)
  analysis      String?
  timeMs        Int         @default(0)
  answeredAt    DateTime    @default(now())
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempt       QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model XPEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  refId     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Achievement {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  description      String
  icon             String
  tier             String            @default("bronze")
  xpReward         Int               @default(50)
  threshold        Int               @default(1)
  category         String            @default("learning")
  createdAt        DateTime          @default(now())
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model StreakLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  xpEarned  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("New Conversation")
  context   String?
  pinned    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  citations      String?
  tokensIn       Int          @default(0)
  tokensOut      Int          @default(0)
  costEstimate   Float        @default(0)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Folder {
  id        String     @id @default(cuid())
  userId    String
  name      String
  color     String     @default("violet")
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents Document[]
  parent    Folder?    @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderChildren")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([parentId])
}

model Document {
  id            String              @id @default(cuid())
  userId        String
  folderId      String?
  title         String
  sourceType    String
  fileName      String
  mimeType      String
  sizeBytes     Int                 @default(0)
  contentText   String
  summary       String?
  storagePath   String?
  tags          String?
  status        String              @default("processing")
  wordCount     Int                 @default(0)
  pageCount     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  diagnostics   DiagnosticSession[]
  folder        Folder?             @relation(fields: [folderId], references: [id])
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks        DocumentChunk[]
  flashcards    Flashcard[]
  learningPlans LearningPlan[]
  quizzes       Quiz[]
  skills        Skill[]             @relation("DocumentSkills")
  topics        Topic[]

  @@index([userId])
  @@index([folderId])
  @@index([sourceType])
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  ordinal    Int
  text       String
  embedding  String?
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Classroom {
  id            String            @id @default(cuid())
  name          String
  description   String?
  code          String            @unique
  ownerId       String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  announcements Announcement[]
  assignments   Assignment[]
  owner         User              @relation("ClassroomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  courses       ClassroomCourse[]
  members       ClassroomMember[]

  @@index([ownerId])
}

model ClassroomMember {
  id          String    @id @default(cuid())
  classroomId String
  userId      String
  role        String    @default("student")
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
}

model ClassroomCourse {
  id          String    @id @default(cuid())
  classroomId String
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([classroomId, courseId])
}

model Assignment {
  id          String       @id @default(cuid())
  classroomId String
  title       String
  description String
  dueDate     DateTime
  maxScore    Int          @default(100)
  courseId    String?
  createdAt   DateTime     @default(now())
  classroom   Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  userId       String
  content      String
  score        Int?
  feedback     String?
  status       String     @default("submitted")
  submittedAt  DateTime   @default(now())
  gradedAt     DateTime?
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([userId])
}

model Announcement {
  id          String     @id @default(cuid())
  classroomId String?
  authorId    String
  title       String
  body        String
  createdAt   DateTime   @default(now())
  author      User       @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId])
}

model Topic {
  id                String              @id @default(cuid())
  documentId        String
  parentId          String?
  authorId          String?
  title             String
  summary           String
  content           String              @default("")
  level             Int                 @default(0)
  order             Int                 @default(0)
  difficulty        Float               @default(0.5)
  estimatedMinutes  Int                 @default(15)
  concepts          String?
  formulas          String?
  definitions       String?
  status            String              @default("generated")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  lessons           InteractiveLesson[]
  learningPlanItems LearningPlanItem[]
  memoryStates      MemoryState[]
  questions         Question[]
  author            User?               @relation("TopicAuthor", fields: [authorId], references: [id])
  parent            Topic?              @relation("TopicChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children          Topic[]             @relation("TopicChildren")
  document          Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  dependents        TopicPrerequisite[] @relation("TopicPrerequisite")
  prerequisites     TopicPrerequisite[] @relation("TopicDependent")

  @@index([documentId])
  @@index([parentId])
}

model TopicPrerequisite {
  topicId        String
  prerequisiteId String
  prerequisite   Topic  @relation("TopicPrerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  topic          Topic  @relation("TopicDependent", fields: [topicId], references: [id], onDelete: Cascade)

  @@id([topicId, prerequisiteId])
}

model LearnerProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  priorKnowledge          Float    @default(0.3)
  conceptualUnderstanding Float    @default(0.3)
  reasoningAbility        Float    @default(0.3)
  confidence              Float    @default(0.5)
  learningSpeed           Float    @default(0.5)
  preferredStyle          String   @default("balanced")
  visualPreference        Float    @default(0.5)
  readingPreference       Float    @default(0.5)
  problemSolving          Float    @default(0.3)
  logicalThinking         Float    @default(0.3)
  memoryRetention         Float    @default(0.5)
  attentionSpan           Float    @default(0.5)
  confidenceGrowth        Float    @default(0.0)
  teachingMode            String   @default("auto")
  companion               String   @default("nova")
  strengths               String?
  weaknesses              String?
  misconceptions          String?
  mistakePatterns         String?
  revisionBehavior        String?
  insights                String?
  totalAssessed           Int      @default(0)
  lastUpdated             DateTime @default(now())
  conversationMemory      String?
  learningStyle           String?
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DiagnosticSession {
  id            String    @id @default(cuid())
  userId        String
  documentId    String
  status        String    @default("active")
  questionCount Int       @default(0)
  correctCount  Int       @default(0)
  results       String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
}

model LearningPlan {
  id               String             @id @default(cuid())
  userId           String
  documentId       String
  status           String             @default("active")
  totalTopics      Int                @default(0)
  completedTopics  Int                @default(0)
  estimatedMinutes Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  document         Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            LearningPlanItem[]

  @@unique([userId, documentId])
  @@index([userId])
}

model LearningPlanItem {
  id           String       @id @default(cuid())
  planId       String
  topicId      String
  order        Int          @default(0)
  status       String       @default("pending")
  isWeak       Boolean      @default(false)
  isPrereq     Boolean      @default(false)
  scheduledFor DateTime?
  topic        Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  plan         LearningPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([topicId])
}

model InteractiveLesson {
  id          String            @id @default(cuid())
  topicId     String
  title       String
  description String?
  stepsJson   String
  stepCount   Int               @default(0)
  createdAt   DateTime          @default(now())
  topic       Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sessions    LearningSession[]

  @@index([topicId])
}

model LearningSession {
  id          String            @id @default(cuid())
  userId      String
  lessonId    String
  topicId     String?
  status      String            @default("active")
  currentStep Int               @default(0)
  socratic    Boolean           @default(true)
  context     String?
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  updatedAt   DateTime          @updatedAt
  lesson      InteractiveLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lessonId])
}

model MemoryState {
  id             String    @id @default(cuid())
  userId         String
  topicId        String
  retention      Float     @default(0.5)
  stability      Float     @default(1.0)
  retrievability Float     @default(0.5)
  repetitions    Int       @default(0)
  lastReview     DateTime?
  nextReview     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  topic          Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, nextReview])
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}
